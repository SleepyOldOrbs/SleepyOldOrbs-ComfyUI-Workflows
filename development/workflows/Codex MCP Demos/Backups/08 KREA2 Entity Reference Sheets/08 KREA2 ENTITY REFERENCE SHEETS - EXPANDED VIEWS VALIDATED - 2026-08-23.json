      "title": "LEAVE ALONE - REF2VA IDENTITY SHEET DIRECTION",
      "properties": {
        "aux_id": "pixaroma/ComfyUI-Pixaroma",
        "ver": "72516552d286901accf5a10fe9619c89b6784932",
        "Node name for S&R": "PixaromaPrompt",
        "cnr_id": "ComfyUI-Pixaroma",
        "promptState": {
          "text": "Create a professional production model sheet for exactly one reusable scene subject using only the description above. The page layout is strict: exactly nine separate, equal square panels arranged as three columns by three rows. Never merge, enlarge, omit or subdivide a panel. Every panel must show the exact same identity with identical facial features or defining geometry, silhouette, proportions, colours, materials, wear, markings, clothing and accessories. Row 1 is face reference: 1 front face close-up with neutral expression; 2 three-quarter face close-up; 3 exact left-profile face close-up. Row 2 is full-body reference, each figure completely visible from head to feet: 4 full-body front neutral stance; 5 full-body three-quarter stance; 6 full-body exact side profile. Row 3 is pose and detail reference: 7 full-body front T-pose, facing camera, arms perfectly straight and horizontal, palms down, head and feet visible; 8 full-body rear T-pose, back to camera, arms perfectly straight and horizontal, head and feet visible; 9 close-up of the most identity-defining feature or accessory. For a subject without a recognizable face, replace row 1 with equivalent front-detail, three-quarter-detail and side-detail close-ups. For a subject where a T-pose is anatomically meaningless, replace panels 7 and 8 with clean orthographic front and rear views; for a building or landscape feature use front and rear elevations, and for a small prop, vehicle or food item use front and rear product views. Use a plain warm-grey studio background, soft even lighting, gentle contact shadows and consistent scale. Put a clear black gutter around every panel. No setting, no unrelated subjects, no alternate designs, no labels, no captions, no text and no decorative outer border. This is one subject shown repeatedly for identity reference, never a group of different subjects.",
          "order": "wired",
          "sep": "\n\n",
          "accent": null,
          "showExpanded": true
        }
      },
      "widgets_values": [
        ""
      ],
      "widgets_values_named": {
        "pix_prompt_ui": ""
      },
